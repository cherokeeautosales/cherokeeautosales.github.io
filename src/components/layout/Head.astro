---
import MetaPixel from "../react/Meta";
import { markdownPath } from '../../data/llms';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalUrl?: string;
}

const { title, description } = Astro.props;
const linkPrefix = Astro.site + import.meta.env.BASE_URL.slice(1, -1);
const image = linkPrefix + (Astro.props.image || "/images/teaser.png");
const favicon = linkPrefix + "/images/favicon.png";
const markdown = markdownPath(Astro.url.pathname, import.meta.env.BASE_URL);

// Dynamic canonical and Open Graph URL
const siteBase = "https://cherokeeautosalestn.com";
const cleanPath = Astro.url.pathname.replace(/\/$/, "");
const canonicalURL = Astro.props.canonicalUrl || `${siteBase}${cleanPath || "/"}`;
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  
  <!-- 1. Meta Title & Description -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="generator" content={Astro.generator} />
  <meta name="google-site-verification" content="a15QYs7MFm1U33fSadgfvbQzeH_SuqviZNDA9T6s-a4" />

  <!-- 2. Canonical & Hreflang -->
  <link rel="canonical" href={canonicalURL} />
  <link rel="alternate" hreflang="en" href={canonicalURL} />
  <link rel="alternate" hreflang="x-default" href={canonicalURL} />

  <!-- Icons & Discovery -->
  <link rel="icon" type="image/x-icon" href={favicon} />
  <link rel="describedby" href={`${import.meta.env.BASE_URL}llms.txt`} type="text/plain" />
  {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}

  <!-- 3. Social Media Optimization (Open Graph & Twitter Cards) -->
  <meta property="og:site_name" content="Cherokee Auto Sales" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />

  <!-- 4. Global AutoDealer Schema.org Structured Data -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "AutoDealer",
      "@id": "https://cherokeeautosalestn.com/#dealership",
      "name": "Cherokee Auto Sales TN",
      "image": "https://cherokeeautosalestn.com/images/warranty.jpg",
      "url": "https://cherokeeautosalestn.com",
      "telephone": "+1-865-687-7100",
      "priceRange": "$500-$7000",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "3423 North Broadway St",
        "addressLocality": "Knoxville",
        "addressRegion": "TN",
        "postalCode": "37917",
        "addressCountry": "US"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 36.0032478,
        "longitude": -83.9269679
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": [
          "Monday",
          "Tuesday",
          "Wednesday",
          "Thursday",
          "Friday",
          "Saturday"
        ],
        "opens": "09:00",
        "closes": "18:00"
      },
      "sameAs": [
        "https://www.facebook.com/cherokeeautosales/",
        "https://www.youtube.com/@cherokeeautosales5096",
        "https://www.instagram.com/cherokeeautosales/?hl=af"
      ]
    }
  </script>

  <MetaPixel client:load />

  <!-- Google Tag Manager (Fiverr 2-19-26) -->
  <script is:inline>
    (function (w, d, s, l, i) {
      w[l] = w[l] || [];
      w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
      var f = d.getElementsByTagName(s)[0],
        j = d.createElement(s),
        dl = l != "dataLayer" ? "&l=" + l : "";
      j.async = true;
      j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
      f.parentNode.insertBefore(j, f);
    })(window, document, "script", "dataLayer", "GTM-54GCCC22");
  </script>
  <!-- End Google Tag Manager -->

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-3Y2HEFV07V"
  ></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    gtag("js", new Date());
    gtag("config", "G-3Y2HEFV07V");
  </script>

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=AW-11003569068"
  ></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    gtag("js", new Date());

    gtag("config", "AW-11003569068");
  </script>

  <style lang="scss" is:global>
    :root {
      --max-width: 1320px;
      --red: #eb0b2d;
      --light-blue: #0056b3;
      --blue: #0b1eeb;
      --dark-blue: #022759;
    }

    body {
      position: relative;
      margin: 0;
      padding: 0;
      min-height: 100vh;
    }
  </style>
  <base href={import.meta.env.BASE_URL} />
</head>
