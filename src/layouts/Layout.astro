---
import "bootstrap/dist/css/bootstrap.min.css";
import "../styles/style.scss";

import Head from "../components/layout/Head.astro";
import NavBar from "../components/layout/NavBar.astro";
import Footer from "../components/layout/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
}

const {
  title = "Used Cars Knoxville TN | In-House Financing | Cherokee Auto",
  description = "Knoxville's premier used car dealer. Cherokee Auto Sales offers dependable pre-owned vehicles, easy in-house financing & low down payments.",
  image,
  canonicalUrl,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <Head
    title={title}
    description={description}
    image={image}
    canonicalUrl={canonicalUrl}
  />
  <body
    style={{
      minHeight: "100vh",
      display: "flex",
      flexDirection: "column",
    }}
  >
    <NavBar />
    <main
      style={{
        flexGrow: 1,
      }}
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>
